let rawAge = " 25 tuổi ";
let rawTicketPrice = " 500.000 đ ";
let rawIsVIP = "true";

let Age = parseInt(rawAge);
let isVip = rawIsVIP === "true";
let cleanPrice = rawTicketPrice.trim().replaceAll(".","").replace("đ","");
let ticketPrice = Number(cleanPrice);
let finalPrice = ticketPrice; 
if (Age > 18 && isVip) 
    {
        finalPrice = ticketPrice - ((ticketPrice/100)*30);
        console.log("Chúc mừng! Bạn đủ điều kiện giảm giá 30%.");
    }
else {
    console.log("Rất tiếc! Bạn không đủ điều kiện giảm giá.");}
    console.log(`Số tiền khách phải trả: ${finalPrice.toLocaleString()} đ`);